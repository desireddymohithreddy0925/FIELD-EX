<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="add-performance-indexes-phase-33" author="fruitivia">
        <!-- Orders -->
        <createIndex tableName="orders" indexName="idx_orders_status">
            <column name="status"/>
        </createIndex>
        <createIndex tableName="orders" indexName="idx_orders_buyer_id">
            <column name="buyer_id"/>
        </createIndex>
        <createIndex tableName="orders" indexName="idx_orders_created_at">
            <column name="created_at"/>
        </createIndex>

        <!-- Quotations -->
        <createIndex tableName="quotations" indexName="idx_quotations_status">
            <column name="status"/>
        </createIndex>
        <createIndex tableName="quotations" indexName="idx_quotations_buyer_id">
            <column name="buyer_id"/>
        </createIndex>

        <!-- Fruit Batches -->
        <createIndex tableName="fruit_batches" indexName="idx_fruit_batches_status">
            <column name="status"/>
        </createIndex>
        <createIndex tableName="fruit_batches" indexName="idx_fruit_batches_supplier_id">
            <column name="supplier_id"/>
        </createIndex>
        <createIndex tableName="fruit_batches" indexName="idx_fruit_batches_fruit_id">
            <column name="fruit_id"/>
        </createIndex>
        <createIndex tableName="fruit_batches" indexName="idx_fruit_batches_warehouse_id">
            <column name="warehouse_id"/>
        </createIndex>

        <!-- Shipments -->
        <createIndex tableName="shipments" indexName="idx_shipments_status">
            <column name="status"/>
        </createIndex>
        <createIndex tableName="shipments" indexName="idx_shipments_order_id">
            <column name="order_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
